# Copy to .env and fill in. .env is gitignored.

# Hilma AVP API — obtain from https://hns-hilma-prod-apim.developer.azure-api.net/ after registering.
# One subscription to the avp-read product covers search, read, and eForms read.
HILMA_SUBSCRIPTION_KEY=

# Azure OpenAI, for embeddings (Phase 2). The deployment must be text-embedding-3-large,
# or adjust Embeddings:Dimensions to match whatever you deploy.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Set true to run without an Azure key, using a deterministic local stand-in.
# Search will work end to end; retrieval quality will be meaningless.
EMBEDDINGS_USE_FAKE=false
