# Copy to .env and fill in. .env is gitignored.

# Hilma AVP API — obtain from https://hns-hilma-prod-apim.developer.azure-api.net/ after registering.
# One subscription to the avp-read product covers search, read, and eForms read.
HILMA_SUBSCRIPTION_KEY=

# Which embedding implementation to use: azure | fake
#   azure — Azure OpenAI deployment (needs the two values below)
#   fake  — deterministic local stand-in; runs with no key, but the vectors carry no meaning,
#           so the retrieval evaluation refuses to score against it
EMBEDDINGS_PROVIDER=azure

# Azure OpenAI, for embeddings. Endpoint looks like https://<resource-name>.openai.azure.com/
# The deployment must be text-embedding-3-large, or adjust Embeddings:Dimensions to match.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Google Gemini, for writing the assessment narrative (Phase 3).
# Key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
