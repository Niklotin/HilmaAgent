{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=hilma;Username=hilma;Password=hilma"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "CollectionName": "notice_chunks"
  },
  "Embeddings": {
    "DeploymentName": "text-embedding-3-large",
    "ModelId": "text-embedding-3-large",
    "Dimensions": 3072,
    "BatchSize": 64,
    "Provider": "azure"
  },
  "Gemini": {
    "Model": "gemini-3.6-flash",
    "MaxSources": 8,
    "RequestTimeout": "00:01:30"
  },
  "Hilma": {
    "SearchBaseUrl": "https://api.hankintailmoitukset.fi/avp",
    "ReadBaseUrl": "https://api.hankintailmoitukset.fi/avp-notice",
    "EFormsBaseUrl": "https://api.hankintailmoitukset.fi/avp-eforms",
    "SearchPath": "eformnotices/docs/search",
    "NoticeDetailPath": "api/avp/notices/{id}",
    "PageSize": 100,
    "RequestsPerWindow": 30,
    "RateLimitWindow": "00:01:00",
    "MaxRetryAttempts": 4,
    "RetryBaseDelay": "00:00:02",
    "RequestTimeout": "00:00:30"
  },
  "Ingestion": {
    "Enabled": true,
    "Interval": "06:00:00",
    "InitialDelay": "00:00:10",
    "MaxNoticesPerRun": 100,
    "IndexAfterIngestion": true,
    "MaxNoticesIndexedPerRun": 200
  }
}
